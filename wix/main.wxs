<?xml version='1.0' encoding='windows-1252'?>

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <!--
      Tokens rewritten by scripts/new_app.ps1:
        ColorMeMuch       : display name (e.g. "My App")
        colormemuch       : lowercase folder name (e.g. "myapp")
        colormemuch        : executable name without .exe (matches Cargo `[[bin]]`)
        ophiocus
        Full control of all RGB features on the Acer Predator Helios Neo 16S AI
        https://github.com/ophiocus/colormemuch
        9FEB6BEB-81AA-4A6E-9EF3-526A86F7906C   : fresh UUID per app
        201DBD27-FA09-4427-8926-4805E54403C4
        5305FDD6-2EDE-43D9-82D5-41371FCCBD58
    -->
    <Product
        Id='*'
        Name='ColorMeMuch'
        UpgradeCode='9FEB6BEB-81AA-4A6E-9EF3-526A86F7906C'
        Manufacturer='ophiocus'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Full control of all RGB features on the Acer Predator Helios Neo 16S AI'
            Manufacturer='ophiocus'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            AllowSameVersionUpgrades='yes'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='colormemuch Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='colormemuch'>

                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='201DBD27-FA09-4427-8926-4805E54403C4' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>
                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='colormemuch.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\colormemuch.exe'
                                KeyPath='yes'/>
                        </Component>
                    </Directory>

                    <Component Id='DesktopShortcut' Guid='5305FDD6-2EDE-43D9-82D5-41371FCCBD58'>
                        <Shortcut Id='DesktopShortcut'
                            Name='ColorMeMuch'
                            Description='Full control of all RGB features on the Acer Predator Helios Neo 16S AI'
                            Directory='DesktopFolder'
                            Target='[Bin]colormemuch.exe'
                            WorkingDirectory='Bin'
                            Icon='ProductICO' />
                        <RegistryValue Root='HKCU'
                            Key='Software\ophiocus\ColorMeMuch'
                            Name='DesktopShortcut'
                            Type='integer'
                            Value='1'
                            KeyPath='yes' />
                    </Component>
                </Directory>
            </Directory>
            <Directory Id='DesktopFolder' Name='Desktop' />
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs the application binary.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='DesktopShortcut'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location to the PATH system environment variable.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <Icon Id='ProductICO' SourceFile='assets\icon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO' />
        <Property Id='ARPHELPLINK' Value='https://github.com/ophiocus/colormemuch'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>

    </Product>

</Wix>
